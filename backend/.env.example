# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration
# MongoDB connection URI (required for persistent storage)
MONGODB_URI=mongodb://127.0.0.1:27017/campusprojecthub
# Explicit development-only fallback (ignored when NODE_ENV=production)
ALLOW_INMEMORY_FALLBACK=false

# Security / Authentication
JWT_SECRET=replace-with-strong-random-secret
JWT_EXPIRES_IN=7d
# Optional controlled provisioning codes
FACULTY_INVITE_CODE=
ADMIN_PROVISION_SECRET=

# AI Provider Configuration
# Supported providers: "mock" | "gemini" | "openai"
# Default is "mock" for zero-cost offline development & automated tests.
AI_PROVIDER=mock

# Gemini API Configuration (when AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Configuration (when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
